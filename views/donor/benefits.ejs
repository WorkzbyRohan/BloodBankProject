<!-- benefits.html -->
<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Earn Benefits</title>
    <script src="https://cdn.tailwindcss.com"></script>
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=Montserrat:wght@400;700&display=swap" rel="stylesheet">
    <style>
        body { font-family: 'Montserrat', sans-serif; }
        .fade-in { animation: fadeIn 1.2s ease; }
        @keyframes fadeIn { from { opacity: 0; transform: translateY(30px);} to { opacity: 1; transform: none; } }
    </style>
</head>
<body class="bg-gradient-to-br from-gray-100 via-red-200 to-gray-300 text-gray-900 min-h-screen flex flex-col">

    <!-- Navbar -->
    <nav class="bg-gradient-to-r from-red-800 via-red-700 to-red-600 text-white p-4 flex justify-between items-center shadow-lg sticky top-0 z-10">
        <div class="text-2xl font-extrabold tracking-wide flex items-center gap-2">
            <span class="inline-block bg-white bg-opacity-10 rounded-full p-1">
                <svg class="w-7 h-7 text-white" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24">
                    <path stroke-linecap="round" stroke-linejoin="round" d="M12 8c-1.657 0-3 1.343-3 3 0 2.5 3 5 3 5s3-2.5 3-5c0-1.657-1.343-3-3-3z"/>
                    <circle cx="12" cy="11" r="3"/>
                </svg>
            </span>
            BloodLink
        </div>
        <div class="space-x-6 text-lg">
            <a href="/donor/donor" class="hover:underline transition">Dashboard</a>
            <a href="/donor/track-record" class="hover:underline transition">Track Record</a>
            <a href="/donor/notifications" class="hover:underline transition">Notifications</a>
            <a href="/donor/benefits" class="underline font-bold">Earn Benefits</a>
            <a href="/index" class="ml-4 hover:underline transition">Logout</a>
        </div>
    </nav>

    <!-- Hero Section -->
    <section class="relative bg-gradient-to-br from-red-900 via-red-700 to-gray-200 py-12 flex flex-col items-center justify-center text-center mb-8 fade-in">
        <img src="https://images.unsplash.com/photo-1506744038136-46273834b3fb?auto=format&fit=crop&w=1200&q=80" alt="Blood Donation" class="absolute inset-0 w-full h-full object-cover opacity-20 pointer-events-none" />
        <div class="relative z-10">
            <h1 class="text-5xl md:text-6xl font-extrabold mb-4 text-red-100 drop-shadow">Earn Exclusive Benefits</h1>
            <p class="text-lg md:text-2xl text-gray-100 mb-6 max-w-2xl mx-auto">Your generosity saves lives—and now, it rewards you! Check out the perks you can unlock by donating blood regularly.</p>
            <a href="/signup" class="inline-block bg-gradient-to-r from-red-700 via-red-600 to-red-500 text-white px-6 py-3 rounded-full font-semibold shadow hover:bg-red-800 transition">Become a Donor</a>
        </div>
    </section>

    <!-- Content -->
    <main class="flex-1 p-6 max-w-4xl mx-auto w-full">
        <h2 class="text-2xl font-bold mb-8 text-center text-red-800">Your Benefits</h2>
        <div class="grid grid-cols-1 md:grid-cols-2 gap-8 fade-in">
            <!-- All Benefits Offered -->
            <div>
                <h3 class="text-xl font-bold mb-4 text-red-700 text-center">All Available Benefits</h3>
                <ul class="space-y-4">
                  <% if (allBenefits && allBenefits.length > 0) { %>
                    <% allBenefits.forEach(function(benefit) { %>
                      <% const earned = earnedBenefits.some(b => b.id === benefit.id); %>
                      <li class="bg-white bg-opacity-95 p-5 rounded-2xl shadow flex flex-col border border-red-200">
                        <span class="font-bold text-lg text-red-800"><%= benefit.name %></span>
                        <span class="text-gray-600">Discount: <%= benefit.discount %>%</span>
                        <span class="text-gray-600">Required Donations: <%= benefit.required_donations %></span>
                        <% if (earned) { %>
                          <span class="mt-2 px-2 py-1 bg-green-200 text-green-800 rounded-full text-xs font-bold w-max">Unlocked</span>
                        <% } else { %>
                          <span class="mt-2 px-2 py-1 bg-gray-200 text-gray-800 rounded-full text-xs font-bold w-max">Locked</span>
                        <% } %>
                      </li>
                    <% }); %>
                  <% } else { %>
                    <li class="text-gray-500">No benefits available.</li>
                  <% } %>
                </ul>
            </div>
            <!-- Earned Benefits -->
            <div>
                <h3 class="text-xl font-bold mb-4 text-green-700 text-center">Benefits You've Earned</h3>
                <ul class="space-y-4">
                  <% if (earnedBenefits && earnedBenefits.length > 0) { %>
                    <% earnedBenefits.forEach(function(benefit) { %>
                      <li class="bg-green-50 bg-opacity-95 p-5 rounded-2xl shadow flex flex-col border border-green-200">
                        <span class="font-bold text-lg text-green-800"><%= benefit.name %></span>
                        <span class="text-gray-600">Discount: <%= benefit.discount %>%</span>
                        <span class="text-gray-600">Required Donations: <%= benefit.required_donations %></span>
                      </li>
                    <% }); %>
                  <% } else { %>
                    <li class="text-gray-500">You haven't earned any benefits yet.</li>
                  <% } %>
                </ul>
            </div>
        </div>
    </main>

    <!-- Footer -->
    <footer class="bg-gradient-to-r from-red-900 via-red-700 to-gray-200 text-gray-100 text-center py-4 mt-12 border-t shadow-inner">
        <span class="font-semibold">&copy; 2025 BloodLink. All rights reserved.</span>
    </footer>

</body>
</html>
